# Free LLM Configuration (Google Gemini / Groq / OpenRouter)
# Option 1: Google AI Studio Gemini (Free Tier: 15 RPM / 1M TPM / 1500 RPD)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Option 2: Groq Cloud (Free Tier: 30 RPM / 14.4k RPD)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Rate Limiting & Origin
FRONTEND_URL=https://personal-portfolio-yzzz.vercel.app
CHAT_RATE_LIMIT=10/minute
GLOBAL_RATE_LIMIT=300/hour
